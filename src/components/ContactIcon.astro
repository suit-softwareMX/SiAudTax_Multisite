---
interface Props { name: "email" | "phone" | "whatsapp" | "location" | "facebook" | "instagram" | "linkedin"; }
const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" aria-hidden="true">
  {name === "email" && <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></>}
  {name === "phone" && <path d="M7.2 3.8 10 7.6 8.3 10c1.2 2.5 3.2 4.5 5.7 5.7l2.4-1.7 3.8 2.8-.5 3c-.2 1-1.1 1.7-2.1 1.7C9.3 21.5 2.5 14.7 2.5 6.4c0-1 .7-1.9 1.7-2.1l3-.5Z"/>}
  {name === "whatsapp" && <><path d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.4-4.7a8.5 8.5 0 1 1 16.1-4.1Z"/><path d="M8.2 7.7c.4 4.2 3.9 7.7 8.1 8.1l1.1-2-2.6-1.2-1.1 1.1a7.8 7.8 0 0 1-3.4-3.4l1.1-1.1-1.2-2.6-2 1.1Z"/></>}
  {name === "location" && <><path d="M20 10c0 5.2-8 11-8 11S4 15.2 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></>}
  {name === "facebook" && <path d="M14 21v-8h2.8l.4-3H14V8.1c0-.9.3-1.6 1.7-1.6h1.8V3.8c-.3 0-1.4-.1-2.6-.1-2.6 0-4.3 1.6-4.3 4.5V10H8v3h2.6v8H14Z"/>}
  {name === "instagram" && <><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle class="fill" cx="17.5" cy="6.5" r="1"/></>}
  {name === "linkedin" && <><path d="M5 8.5V20M5 5.2v.1M10 20v-6.3a3.7 3.7 0 0 1 7.4 0V20M10 11v9"/><path class="fill" d="M3.5 8.5h3V20h-3z"/></>}
</svg>

<style>
  svg { fill: none; height: 1.45rem; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; width: 1.45rem; }
  .fill { fill: currentColor; stroke: none; }
</style>
