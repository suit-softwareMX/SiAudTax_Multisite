---
import type { Locale } from "../lib/i18n";

interface Props { locale: Locale; }
const { locale } = Astro.props;
---

<svg class="flag-icon" viewBox="0 0 28 20" aria-hidden="true">
  {locale === "es" && <><rect width="28" height="20" rx="2" fill="#AA151B"/><rect y="5" width="28" height="10" fill="#F1BF00"/><rect x="8" y="8" width="2.5" height="4" rx=".4" fill="#AA151B"/></>}
  {locale === "pt" && <><rect width="28" height="20" rx="2" fill="#046A38"/><rect x="11" width="17" height="20" rx="2" fill="#DA291C"/><circle cx="11" cy="10" r="4.5" fill="#FFCD00"/><circle cx="11" cy="10" r="3.2" fill="#fff"/><circle cx="11" cy="10" r="2.8" fill="#1F4E79"/></>}
  {locale === "en" && <><rect width="28" height="20" rx="2" fill="#012169"/><path d="M0 0 28 20M28 0 0 20" stroke="#fff" stroke-width="5"/><path d="M0 0 28 20M28 0 0 20" stroke="#C8102E" stroke-width="2"/><path d="M14 0v20M0 10h28" stroke="#fff" stroke-width="6"/><path d="M14 0v20M0 10h28" stroke="#C8102E" stroke-width="3"/></>}
</svg>

<style>
  .flag-icon { border-radius: 2px; box-shadow: 0 0 0 1px rgb(7 29 44 / .1); flex: 0 0 auto; height: 1rem; width: 1.4rem; }
</style>
