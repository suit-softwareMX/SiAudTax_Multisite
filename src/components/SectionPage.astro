---
import ArrowIcon from "./ArrowIcon.astro";
import ContactSection from "./ContactSection.astro";
import WorldMap from "./WorldMap.astro";
import { getCatalog, localizedPath, type Locale, type PageId } from "../lib/i18n";

interface Props { locale: Locale; page: PageId; }
const { locale, page } = Astro.props;
const catalog = getCatalog(locale);
const legalKey = page === "privacidad" ? "privacy" : page === "terminos" ? "terms" : "ethics";
const legalPage = catalog.legal.pages[legalKey];
---

{page === "consorcio" && (
  <>
    <header class="page-hero section-shell"><p class="section-label">{catalog.nav.consortium}</p><h1>{catalog.consortium.title}</h1><p>{catalog.consortium.intro}</p></header>
    <section class="editorial-split section-shell">
      <div class="prose-stack">{catalog.consortium.body.map((paragraph) => <p>{paragraph}</p>)}</div>
      <img src="/images/modern-office-glass.webp" alt={catalog.consortium.imageAlt} width="1800" height="1200" loading="eager" decoding="async" />
    </section>
    <section class="promise-section section-shell">
      <div><h2>{catalog.consortium.promiseTitle}</h2><p>{catalog.consortium.promiseBody}</p></div>
      <ul>{catalog.consortium.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
    </section>
    <section class="values-section section-shell"><h2>{catalog.consortium.valuesTitle}</h2><ol class="value-ledger">{catalog.consortium.values.map((value, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{value.title}</h3><p>{value.body}</p></div></li>)}</ol></section>
    <section class="method-section"><div class="section-shell method-inner"><div><h2>{catalog.consortium.modelTitle}</h2><p>{catalog.consortium.modelBody}</p></div><ol>{catalog.consortium.modelSteps.map((step, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><h3>{step.title}</h3><p>{step.body}</p></li>)}</ol></div></section>
  </>
)}

{page === "red-global" && (
  <div class="network-page">
    <div class="section-shell"><header class="page-hero compact-hero"><p class="section-label">{catalog.nav.network}</p><h1>{catalog.network.title}</h1><p>{catalog.network.intro}</p></header><WorldMap {locale} /></div>
    <section class="network-support"><div class="section-shell network-support-inner"><div><h2>{catalog.network.supportTitle}</h2><p>{catalog.network.supportBody}</p></div><ol>{catalog.network.supportItems.map((item, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.body}</p></li>)}</ol></div></section>
  </div>
)}

{page === "especialidades" && (
  <><header class="page-hero section-shell"><p class="section-label">{catalog.nav.specialties}</p><h1>{catalog.specialties.title}</h1><p>{catalog.specialties.intro}</p></header><section class="service-detail section-shell">{catalog.specialties.services.map((service, index) => <article><span>{String(index + 1).padStart(2, "0")}</span><div><h2>{service.title}</h2><p>{service.body}</p><ul>{service.details.map((detail) => <li>{detail}</li>)}</ul></div></article>)}</section></>
)}

{page === "perspectivas" && (
  <><header class="page-hero section-shell"><p class="section-label">{catalog.nav.perspectives}</p><h1>{catalog.perspectives.title}</h1><p>{catalog.perspectives.intro}</p></header><section class="perspective-grid section-shell">{catalog.perspectives.topics.map((topic, index) => <article><span>{String(index + 1).padStart(2, "0")} · {topic.category}</span><h2>{topic.title}</h2><p>{topic.body}</p></article>)}</section><section class="perspective-closing section-shell"><span class="publication-mark"></span><div><h2>{catalog.perspectives.closingTitle}</h2><p>{catalog.perspectives.closingBody}</p></div></section></>
)}

{page === "contacto" && (
  <ContactSection {locale} standalone />
)}

{["privacidad", "terminos", "etica"].includes(page) && (
  <><header class="page-hero legal-hero section-shell"><p class="section-label">{catalog.footer.legal}</p><h1>{catalog.legal[legalKey]}</h1><p>{legalPage.intro}</p></header><section class="legal-content section-shell">{legalPage.sections.map((section, index) => <article><span>{String(index + 1).padStart(2, "0")}</span><div><h2>{section.title}</h2><p>{section.body}</p></div></article>)}<a class="text-link" href={localizedPath(locale)}>{catalog.common.backHome}<ArrowIcon /></a></section></>
)}
