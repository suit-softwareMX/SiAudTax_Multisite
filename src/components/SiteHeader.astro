---
import Logo from "./Logo.astro";
import FlagIcon from "./FlagIcon.astro";
import { getCatalog, localizedPath, type Locale, type PageId } from "../lib/i18n";

interface Props {
  locale: Locale;
  currentPage?: PageId;
}

const { locale, currentPage } = Astro.props;
const catalog = getCatalog(locale);
const nav = [
  ["consorcio", catalog.nav.consortium],
  ["red-global", catalog.nav.network],
  ["especialidades", catalog.nav.specialties],
  ["perspectivas", catalog.nav.perspectives],
  ["contacto", catalog.nav.contact],
] as const;
const languageNames: Record<Locale, string> = { es: "Español", en: "English", pt: "Português" };
const homePath = localizedPath(locale);
---

<header class="site-header">
  <div class="header-inner">
    <Logo {locale} />
    <nav class="desktop-nav" aria-label={catalog.common.mainNav}>
      {nav.map(([page, label]) => (
        <a href={`${homePath}#${page}`}>{label}</a>
      ))}
    </nav>
    <details class="language-switcher desktop-languages">
      <summary aria-label={`${catalog.common.language}: ${languageNames[locale]}`}><FlagIcon locale={locale} /><span>{languageNames[locale]}</span><svg class="language-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg></summary>
      <nav aria-label={catalog.common.language}>
        {(["es", "en", "pt"] as Locale[]).map((target) => (
          <a href={localizedPath(target, currentPage)} lang={target} aria-current={target === locale ? "page" : undefined}><FlagIcon locale={target} /><span>{languageNames[target]}</span><small>{target.toUpperCase()}</small></a>
        ))}
      </nav>
    </details>
    <details class="mobile-menu">
      <summary><span>{catalog.common.menu}</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14"/></svg></summary>
      <div class="mobile-panel">
        <nav aria-label={catalog.common.mainNav}>
          {nav.map(([page, label]) => <a href={`${homePath}#${page}`}>{label}</a>)}
        </nav>
        <nav class="mobile-languages" aria-label={catalog.common.language}>
          {(["es", "en", "pt"] as Locale[]).map((target) => (
            <a href={localizedPath(target, currentPage)} lang={target} aria-current={target === locale ? "page" : undefined}><FlagIcon locale={target} /><span>{languageNames[target]}</span></a>
          ))}
        </nav>
      </div>
    </details>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLAnchorElement>(".mobile-panel a").forEach((link) => link.addEventListener("click", () => link.closest("details")?.removeAttribute("open")));
</script>
